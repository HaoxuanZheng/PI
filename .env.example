# Public Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Server-only database connection. Keep this out of browser code.
DATABASE_URL=postgresql://postgres:password@localhost:5432/lifegraph

# Public application origin used for auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional in development; required in production.
SENTRY_DSN=
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_BASE_URL=https://api.openai.com/v1

# Server-only storage credentials. Required in production; without them file capture falls back to
# an in-process adapter for local development. The bucket must be private.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=lifegraph-private
# Blocks downloads until a scanner records CLEAN. Cannot be disabled in production.
STORAGE_REQUIRE_SCAN=true

# Server-only read-only Google Drive token. V0.11 has no OAuth consent flow.
GOOGLE_DRIVE_ACCESS_TOKEN=
